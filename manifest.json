{
  "manifest_version": 3,
  "name": "Speech Enhancer for Meet & Zoom",
  "version": "2.0.0",
  "description": "Real-time Wiener filter speech noise reduction running 100% inside your browser for Google Meet and Zoom.",
  "icons": {
    "16": "assets/logo/icon16.png",
    "32": "assets/logo/icon32.png",
    "48": "assets/logo/icon48.png",
    "128": "assets/logo/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Speech Enhancer",
    "default_icon": {
      "16": "assets/logo/icon16.png",
      "32": "assets/logo/icon32.png",
      "48": "assets/logo/icon48.png",
      "128": "assets/logo/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wiener_processor.js", "inject.js"],
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*"
      ]
    }
  ]
}
